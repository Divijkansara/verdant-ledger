{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "python",
      "runtimeArgs": ["web/serve.py"],
      "port": 5500
    },
    {
      "name": "api",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--app-dir", "backend", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "web-react",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web-react", "run", "dev"],
      "port": 5173
    }
  ]
}
