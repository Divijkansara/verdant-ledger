# Copy to .env and edit. Never commit the real .env.

# SQLite (default — zero setup)
DATABASE_URL=sqlite:///./verdant_ledger.db

# PostgreSQL / Supabase (uncomment to use instead). Paste the Supabase
# connection string as-is; postgres:// and postgresql:// both work.
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# Generate a real one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-this-is-a-dev-key

ACCESS_TOKEN_EXPIRE_MINUTES=720
DEBUG=true

# Wherever the frontend runs (Vite 5173, CRA 3000, Live Server 5500)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5500,http://localhost:5500
