{
  // Ctrl+Shift+P → "Tasks: Run Task", or Terminal → Run Task.
  // "Terrawise: everything" starts both halves at once.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Terrawise: website",
      "type": "shell",
      "command": "python web/serve.py",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "terrawise" },
      "detail": "Serves the site on http://localhost:5500 and opens a browser."
    },
    {
      "label": "Terrawise: API",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe -m uvicorn app.main:app --reload --port 8000",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "terrawise" },
      "detail": "Runs the FastAPI service on http://127.0.0.1:8000 (docs at /docs)."
    },
    {
      "label": "Terrawise: everything",
      "dependsOn": ["Terrawise: API", "Terrawise: website"],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true },
      "detail": "Both halves, for a demo that does not depend on the internet."
    },
    {
      "label": "Terrawise: backend tests",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe -m pytest -q",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": [],
      "presentation": { "panel": "dedicated" },
      "detail": "Runs the 53 automated tests."
    }
  ]
}
